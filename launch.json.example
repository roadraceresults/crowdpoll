{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "src/server.ts"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ENV_PORT": "8080",
        "ENV_DATABASE_URL": "",
        "ENV_ADMINS": "roadraceresults@gmail.com",
        "ENV_SCREENING_CALL_TIMEOUT": "10000",
        "ENV_POLL_APPROVAL_SWEEP_INTERVAL": "5000",
        "ENV_POLL_DATE_CHECK_SWEEP_INTERVAL": "60000",
