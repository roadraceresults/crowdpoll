# Copy to infra/secrets.auto.tfvars (git-ignored) and fill in. Never commit the copy.
# The first seven are required; a login provider is set with all its values, or left empty.
better_auth_secret            = ""
ses_access_key_id             = ""
ses_secret_access_key         = ""
spaces_access_id              = ""
spaces_secret_key             = ""
allowed_emails                = ""
device_events_key             = ""
oauth_google_client_id        = ""
oauth_google_client_secret    = ""
oauth_apple_client_id         = ""
oauth_apple_team_id           = ""
oauth_apple_key_id            = ""
oauth_apple_private_key       = ""
oauth_microsoft_client_id     = ""
oauth_microsoft_client_secret = ""
oauth_amazon_client_id        = ""
oauth_amazon_client_secret    = ""

