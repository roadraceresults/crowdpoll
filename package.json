{
  "name": "native-auth-oauth",
  "version": "0.1.0",
  "description": "Reusable passwordless user-authentication system (email magic links, switchable to OAuth) with a minimal demo web client",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsx devScripts/build-assets.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "reconcile": "tsx devScripts/reconcile.ts",
    "fix-migrations": "tsx devScripts/fix-migrations.ts",
    "publish-assets": "tsx devScripts/publish-assets.ts",
    "file-manifest": "tsx devScripts/file-manifest.ts",
    "prototypes": "tsx devScripts/serve-prototypes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1135.0",
    "@aws-sdk/client-sesv2": "3.1135.0",
    "@opensearch-project/opensearch": "3.6.0",
    "better-auth": "^1.3.0",
    "compression": "1.8.2",
    "express": "^5.1.0",
    "iovalkey": "0.4.0",
    "kysely": "0.29.6",
    "nodemailer": "^7.0.0",
    "pg": "8.23.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6.0.0",
    "embedded-postgres": "16.14.0-beta.17",
    "jsdom": "30.1.0",
    "supertest": "^7.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
